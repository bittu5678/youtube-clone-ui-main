# FaceTube Environment Variables Example
# Copy to .env and fill in values as needed.
# Without MySQL credentials, the local preview server falls back to data/facetube_store.json.

# Runtime Environment
NODE_ENV=development
APP_ENV=development
PORT=3000

# Optional Remote Hostinger PHP Backend Proxy
USE_REMOTE_PHP_API=false
VITE_API_BASE_URL=

# Optional MySQL Database (Hostinger / Cloud SQL)
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# Optional Supabase Auth / Client Config
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional Razorpay Payments
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_SKIP_REMOTE_CHECK=false

# Optional LiveKit Streaming
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Optional Google AdMob OAuth & Config
ADMOB_APP_ID=
ADMOB_PUBLISHER_ID=
ADMOB_OAUTH_CLIENT_ID=
ADMOB_OAUTH_CLIENT_SECRET=
ADMOB_OAUTH_REDIRECT_URI=
ADMOB_ENCRYPTION_KEY=
ADMOB_SKIP_REMOTE_CHECK=false

# Optional SMTP / Email Delivery
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_FROM=
SMTP_USER=
SMTP_PASS=
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Optional Business Logic Config
MARKETING_INCOME_PERCENTAGE=
FACETUBE_ENABLE_PREMIUM_RECOVERY_LIVE_WRITES=false
