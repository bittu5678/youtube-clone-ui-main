# ==============================================================================
# FaceTube - Private Storage Protection
# Block all direct web/HTTP access to private media files and signing secrets.
# ==============================================================================

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>

Options -Indexes
